# ==============================================================================
# BIODASH AI SERVICE - FASTAPI + WHISPER (ENV EXAMPLE)
# ==============================================================================
# Copie este arquivo para .env para customizar as configurações de execução local.

# Porta HTTP do serviço FastAPI (padrão: 5000)
AI_SERVICE_PORT=5000

# Configurações do Modelo de Transcrição Whisper
# Modelos disponíveis: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Dispositivo de processamento: 'cpu' ou 'cuda'
WHISPER_DEVICE=cpu

# Tipo de computação: 'int8', 'float16' ou 'float32' (int8 é recomendado para CPU)
WHISPER_COMPUTE_TYPE=int8

# Limite máximo de bytes para upload de áudio (20MB = 20971520 bytes)
MAX_AUDIO_BYTES=20971520

# Vocabulário e contexto para inicialização do Whisper (opcional)
# WHISPER_INITIAL_PROMPT="Conversa em português brasileiro sobre o sistema BioDash. Vocabulário: biodigestor, biodigestores, resíduos, energia, kWh, quilogramas, benefícios fiscais, métricas, manutenção, relatório, endereço, localização e CEP."
